# Copy to backend/.env for local API runs.
# Never commit a filled .env.

# sqlite for local development.
DATABASE_URL=sqlite:///./wisebar.db

# Microsoft SQL Server (install the ODBC driver and pip install -r requirements-mssql.txt)
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@HOST:1433/wisebar?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First operator. Created once if the email does not exist yet.
ADMIN_EMAIL=admin@wisebar.example
ADMIN_PASSWORD=change-me-now

# Leave blank until the accounts exist. The API will not invent charges.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Analytics stays first-party until this is set.
GA_MEASUREMENT_ID=

# Optional S3-compatible storage for product and journal images.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# Set when transactional email exists. Password reset will not pretend to send before that.
SMTP_HOST=
SMTP_FROM=
